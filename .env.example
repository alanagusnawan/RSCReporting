PORT=5488

# PostgreSQL
PG_HOST=localhost
PG_PORT=5435
PG_DATABASE=report
PG_USER=report_user
PG_PASSWORD=report_password
DATABASE_URL="postgresql://report_user:report_password@localhost:5435/report?schema=public"

# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=template-report
MINIO_USE_SSL=false

# Public Base URLs
API_PUBLIC_BASE_URL=http://localhost:5488
WEB_PUBLIC_BASE_URL=http://localhost:3000

# Auth & Limits
JWT_SECRET=supersecret-reporting-engine-key-replace-in-production
PRINT_AGENT_TOKEN=secret-print-token-12345
ARTIFACT_URL_TTL_SECONDS=3600
PDF_ARTIFACT_RETENTION_DAYS=30
MAX_UPLOAD_SIZE_MB=50
MAX_REPORT_ROWS=100000
MAX_REPORT_EXECUTION_MS=60000
MAX_PDF_PAGES=500
MAX_CONCURRENT_EXECUTIONS=10
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
