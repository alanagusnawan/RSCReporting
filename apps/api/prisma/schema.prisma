datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Report {
  id               String            @id @default(uuid())
  name             String
  description      String?
  category         String?           @default("General")
  tags             String[]          @default([])
  status           String            @default("draft")
  ownerId          String            @default("system")
  currentVersionId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  revision         Int               @default(1)
  definitions      ReportDefinitionRecord[]
}

model ReportDefinitionRecord {
  id            String   @id @default(uuid())
  reportId      String
  schemaVersion String   @default("1.0.0")
  version       Int      @default(1)
  definition    Json
  checksum      String
  createdBy     String   @default("system")
  createdAt     DateTime @default(now())
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model Template {
  id             String            @id
  name           String
  description    String?
  category       String?           @default("Templates")
  tags           String[]          @default([])
  status         String            @default("published")
  schemaVersion  String            @default("1.0.0")
  currentVersion Int               @default(1)
  ownerId        String            @default("system")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  revision       Int               @default(1)
  versions       TemplateVersion[]
}

model TemplateVersion {
  id                 String   @id @default(uuid())
  templateId         String
  version            Int
  definition         Json
  definitionChecksum String
  createdBy          String   @default("system")
  createdAt          DateTime @default(now())
  changeDescription  String?
  template           Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

model DataSourceRecord {
  id            String   @id @default(uuid())
  name          String
  providerType  String
  configuration Json     @default("{}")
  status        String   @default("active")
  ownerId       String   @default("system")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DatasetRecord {
  id          String   @id @default(uuid())
  name        String
  description String?
  sourceType  String   @default("json")
  fileId      String?
  schema      Json?
  version     Int      @default(1)
  status      String   @default("active")
  ownerId     String   @default("system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FileRecord {
  id                String    @id @default(uuid())
  originalFilename  String
  sanitizedFilename String
  mimeType          String
  sizeBytes         Int
  sha256            String
  bucket            String    @default("template-report")
  objectKey         String
  category          String    @default("asset")
  version           Int       @default(1)
  ownerId           String    @default("system")
  createdAt         DateTime  @default(now())
  expiresAt         DateTime?
}

model PdfArtifact {
  id              String     @id @default(uuid())
  reportId        String?
  templateId      String?
  templateVersion Int?
  executionId     String?
  filename        String
  mimeType        String     @default("application/pdf")
  sizeBytes       Int
  checksum        String
  bucket          String     @default("template-report")
  objectKey       String
  ownerId         String     @default("system")
  createdAt       DateTime   @default(now())
  expiresAt       DateTime?
  printJobs       PrintJob[]
}

model ExecutionRecord {
  id                 String    @id @default(uuid())
  reportId           String?
  reportVersion      Int?
  status             String    @default("pending")
  parametersMetadata Json?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  durationMs         Int?
  errorCode          String?
  diagnosticsSummary String?
  ownerId            String    @default("system")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrintAgent {
  id              String           @id // agentId dari Go Agent
  name            String           // displayName (misal: "Kasir Depan", "Admin Gudang")
  hostname        String?
  os              String?
  version         String?
  status          String           @default("offline") // online | offline
  ips             Json?            // Array string IP LAN, misal ["172.16.0.21"]
  wsConnectionId  String?
  printers        String[]         @default([])
  lastSeenAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  printJobs       PrintJob[]
  agentPrinters   AgentPrinter[]
  sourceShares    PrinterShare[]   @relation("SourceAgentShares")
  targetShares    PrinterShare[]   @relation("TargetAgentShares")
}

model AgentPrinter {
  id          String     @id @default(uuid())
  agentId     String
  name        String
  isDefault   Boolean    @default(false)
  status      String     @default("ready")
  shared      Boolean    @default(false)
  shareName   String?
  protocol    String?    // smb | ipp | relay
  smbPath     String?    // \\PC-A\RSC-Thermal
  ippUri      String?    // ipp://PC-A.local:631/printers/Laser
  socketUri   String?    // socket://PC-A:9100
  relayUri    String?    // ipp://PC-A:19100/printers/Laser
  updatedAt   DateTime   @updatedAt
  agent       PrintAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, name])
  @@index([agentId])
}

model PrinterShare {
  id                String     @id @default(uuid())
  sourceAgentId     String
  sourcePrinterName String
  targetAgentId     String
  targetQueueName   String     // Nama queue di OS target B, misal "A-Thermal"
  printerType       String     @default("HTTP_SHARED")
  endpointUsed      String     // Endpoint portOrUri yang dikirim ke B
  driverName        String?    @default("Generic / Text Only")
  isDefault         Boolean    @default(false)
  status            String     @default("pending") // pending | installed | failed
  errorMessage      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sourceAgent       PrintAgent @relation("SourceAgentShares", fields: [sourceAgentId], references: [id], onDelete: Cascade)
  targetAgent       PrintAgent @relation("TargetAgentShares", fields: [targetAgentId], references: [id], onDelete: Cascade)

  @@unique([sourceAgentId, sourcePrinterName, targetAgentId])
  @@index([sourceAgentId])
  @@index([targetAgentId])
}

model PrinterAuditLog {
  id            String   @id @default(uuid())
  actorUserId   String?  @default("system")
  action        String   // SHARE | UNSHARE | INSTALL | UNINSTALL | REPOINT | SET_DEFAULT
  sourceAgentId String?
  targetAgentId String?
  printerName   String
  detail        Json?
  createdAt     DateTime @default(now())

  @@index([sourceAgentId])
  @@index([targetAgentId])
}

model PrintJob {
  id                      String       @id @default(uuid())
  artifactId              String
  printerId               String
  agentId                 String?
  adapterType             String       @default("http")
  status                  String       @default("pending")
  idempotencyKey          String?      @unique
  externalJobId           String?
  adapterResponseMetadata Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  completedAt             DateTime?
  errorCode               String?
  artifact                PdfArtifact  @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  agent                   PrintAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
}
